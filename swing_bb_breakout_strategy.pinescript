//@version=6
// SWING2: Bollinger Band Squeeze Breakout (Volatility Expansion)
// Optimised: TRXUSDT · 15m · Long only · Fixed-% SL/TP
// Best combo: MON · W-Sharpe 3.66 · S2-Sharpe 2.29
//
// Entry:   BB width contracts for squeeze_bars, then price closes above upper BB
//          confirmed by MACD line > signal line (momentum behind the move).
// SL:      Fixed % below entry (default 1.5 %)
// TP:      Fixed % above entry (default 6.0 %)
// Sizing:  (equity × risk %) / stop_distance in price

strategy('SWING2: BB Squeeze Breakout', overlay=true, initial_capital=100000, currency='USD',
         default_qty_type=strategy.fixed, default_qty_value=1)

// === RISK ===
risk_per_trade  = input.float(1.0, 'Risk % / Trade', minval=0.1, maxval=5,  group='Risk')
stop_loss_pct   = input.float(1.5, 'Stop Loss %',    minval=0.1, maxval=20, group='Risk')
take_profit_pct = input.float(6.0, 'Take Profit %',  minval=0.1, maxval=50, group='Risk')

// === STRATEGY ===
direction    = input.string('Long', 'Direction', options=['Long','Short','Both'], group='Strategy')
bb_length    = input.int(25,  'BB Length',     minval=5,  group='Strategy')
bb_mult      = input.float(2.0,'BB Mult',      minval=0.5,group='Strategy')
squeeze_bars = input.int(5,   'Squeeze Bars',  minval=2,  group='Strategy')
macd_fast    = input.int(10,  'MACD Fast',     minval=1,  group='Strategy')
macd_slow    = input.int(24,  'MACD Slow',     minval=1,  group='Strategy')
macd_sig     = input.int(9,   'MACD Signal',   minval=1,  group='Strategy')

// === DAY FILTER — defaults = MON only (best combo) ===
trade_mon = input.bool(true,  'Mon', group='Days', inline='d')
trade_tue = input.bool(false, 'Tue', group='Days', inline='d')
trade_wed = input.bool(false, 'Wed', group='Days', inline='d')
trade_thu = input.bool(false, 'Thu', group='Days', inline='d')
trade_fri = input.bool(false, 'Fri', group='Days', inline='d')
trade_sat = input.bool(false, 'Sat', group='Days', inline='d')
trade_sun = input.bool(false, 'Sun', group='Days', inline='d')

// === VISUALS ===
show_lines = input.bool(true, 'Show Trade Lines', group='Visual')
line_bars  = input.int(45, 'Line Bars', minval=1, maxval=200, group='Visual')

// === INDICATORS ===
basis    = ta.sma(close, bb_length)
dev      = bb_mult * ta.stdev(close, bb_length)
upper_bb = basis + dev
lower_bb = basis - dev
bb_width = (upper_bb - lower_bb) / basis

[macd_l, sig_l, _] = ta.macd(close, macd_fast, macd_slow, macd_sig)

// === SQUEEZE ===
squeezed     = bb_width < ta.lowest(bb_width, squeeze_bars)[1]
was_squeezed = ta.barssince(squeezed) <= squeeze_bars

// === DAY FILTER ===
allow_day = (dayofweek == dayofweek.monday    and trade_mon) or
            (dayofweek == dayofweek.tuesday   and trade_tue) or
            (dayofweek == dayofweek.wednesday and trade_wed) or
            (dayofweek == dayofweek.thursday  and trade_thu) or
            (dayofweek == dayofweek.friday    and trade_fri) or
            (dayofweek == dayofweek.saturday  and trade_sat) or
            (dayofweek == dayofweek.sunday    and trade_sun)

long_ok  = direction == 'Long'  or direction == 'Both'
short_ok = direction == 'Short' or direction == 'Both'

// === POSITION SIZING ===
risk_amt  = strategy.equity * risk_per_trade / 100
stop_dist = close * stop_loss_pct / 100
qty       = stop_dist > 0 ? risk_amt / stop_dist : 0

// === ENTRIES ===
long_cond  = was_squeezed and close > upper_bb and macd_l > sig_l and allow_day and long_ok  and strategy.position_size == 0
short_cond = was_squeezed and close < lower_bb and macd_l < sig_l and allow_day and short_ok and strategy.position_size == 0

if long_cond and qty > 0
    sl = close * (1 - stop_loss_pct   / 100)
    tp = close * (1 + take_profit_pct / 100)
    strategy.entry('Long',  strategy.long,  qty=qty)
    strategy.exit ('Exit L','Long',  stop=sl, limit=tp)

if short_cond and qty > 0
    sl = close * (1 + stop_loss_pct   / 100)
    tp = close * (1 - take_profit_pct / 100)
    strategy.entry('Short', strategy.short, qty=qty)
    strategy.exit ('Exit S','Short', stop=sl, limit=tp)

// === TRADE LINES ===
if show_lines and strategy.position_size > 0 and strategy.position_size[1] <= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                         bar_index+line_bars, e,                         color=color.white, width=2)
    line.new(bar_index, e*(1-stop_loss_pct/100),   bar_index+line_bars, e*(1-stop_loss_pct/100),   color=color.red,   width=2)
    line.new(bar_index, e*(1+take_profit_pct/100), bar_index+line_bars, e*(1+take_profit_pct/100), color=color.green, width=2)

if show_lines and strategy.position_size < 0 and strategy.position_size[1] >= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                         bar_index+line_bars, e,                         color=color.white, width=2)
    line.new(bar_index, e*(1+stop_loss_pct/100),   bar_index+line_bars, e*(1+stop_loss_pct/100),   color=color.red,   width=2)
    line.new(bar_index, e*(1-take_profit_pct/100), bar_index+line_bars, e*(1-take_profit_pct/100), color=color.green, width=2)

plot(upper_bb, 'Upper BB', color.red,   linewidth=1)
plot(lower_bb, 'Lower BB', color.green, linewidth=1)
plot(basis,    'Basis',    color.gray,  linewidth=1)
