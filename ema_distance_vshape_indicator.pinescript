//@version=6
// TF: Any | Type: Indicator (sub-chart) | Target: N/A
//
// Description:
//   Sub-chart indicator that plots the % distance of price from EMA200.
//   Detects and marks pivot highs and lows in the distance series when they
//   exceed configurable thresholds (default ±15%), and highlights V-shape and
//   inverted-V-shape reversals within the distance oscillator.
//
// Main idea:     Visualise how stretched price is from EMA200 as an oscillator.
//               Pivot marks and V-shape detection identify likely reversal zones.
// Max hold bars: NA — indicator only.
// Stop loss:     NA — indicator only.
// Take profit:   NA — indicator only.
indicator(title = "EMA 200 Distance & V-Shape Reversals", shorttitle = "EMA200-VShape", overlay = false)

// === Input Parameters ===
ema200length = input.int(title = 'EMA 200 Length', defval = 200, minval = 1, group = 'EMA Settings')
ema55length = input.int(title = 'Smoothing EMA Length', defval = 55, minval = 1, group = 'EMA Settings')

leftbar = input.int(title = 'Leftbar', defval = 15, minval = 1, group = 'Pivots')
rightbar = input.int(title = 'Rightbar', defval = 1, minval = 0, group = 'Pivots')
pivothighfilter = input.float(title = 'Minimum pivot high', defval = 15, minval = 0, step = 0.1, group = 'Pivots')
pivotlowfilter = input.float(title = 'Maximum pivot low', defval = -15, maxval = 0, step = 0.1, group = 'Pivots')

lookback = input.int(title = 'V-Shape Lookback', defval = 20, minval = 5, group = 'V-Shape Detection')

// === Core Calculations ===
ema200 = ta.ema(close, ema200length)

// Standard EMA distance calculation (negative = below EMA, positive = above EMA)
emaDistance = (close - ema200) / ema200 * 100

// Smoothed EMA of distance
emaOfDistance = ta.ema(emaDistance, ema55length)

// === V-Shape Pattern Detection ===
// Calculate range of EMA distance over lookback period
lowestLow = ta.lowest(emaDistance, lookback)
highestHigh = ta.highest(emaDistance, lookback)
distRange = highestHigh - lowestLow

// Buy V-shape: In lowest quartile and recovering
isInLowestQuartile = emaDistance <= lowestLow + distRange * 0.25
isRecovering = emaDistance > emaDistance[1]
vShapeBuy = isInLowestQuartile and isRecovering

// Sell V-shape: In highest quartile and declining
isInHighestQuartile = emaDistance >= highestHigh - distRange * 0.25
isDeclining = emaDistance < emaDistance[1]
vShapeSell = isInHighestQuartile and isDeclining

// === Pivot Detection ===
pivothigh = ta.pivothigh(emaDistance, leftbar, rightbar)
pivotlow = ta.pivotlow(emaDistance, leftbar, rightbar)

pivotHighConfirmed = pivothigh > pivothighfilter
pivotLowConfirmed = pivotlow < pivotlowfilter

// === Plotting ===
// Main distance line
plot(emaDistance, color = color.new(color.purple, 0), linewidth = 2, title = "EMA 200 Distance %")

// Smoothed EMA line
plot(emaOfDistance, color = color.new(color.white, 0), linewidth = 1, title = "EMA55 of Distance")

// Pivot points
plot(pivotHighConfirmed ? pivothigh : na, color = color.new(color.red, 0), linewidth = 2, 
  style = plot.style_circles, title = "Pivot High")
plot(pivotLowConfirmed ? pivotlow : na, color = color.new(color.green, 0), linewidth = 2, 
  style = plot.style_circles, title = "Pivot Low")

// Quartile zones (optional backgrounds)
lowestQuartileLevel = lowestLow + distRange * 0.25
highestQuartileLevel = highestHigh - distRange * 0.25

plot(lowestQuartileLevel, color = color.new(color.green, 80), linewidth = 1, 
  style = plot.style_stepline, title = "Buy Zone Threshold")
plot(highestQuartileLevel, color = color.new(color.red, 80), linewidth = 1, 
  style = plot.style_stepline, title = "Sell Zone Threshold")

// Zero line
hline(0, "Zero Line", color = color.new(color.yellow, 0), linewidth = 2)
