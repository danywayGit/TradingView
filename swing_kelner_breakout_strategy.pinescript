//@version=6
// SWING5: Keltner Channel Breakout (Trend Continuation)
// Optimised: SUIUSDT · 4H · Long only · ATR SL
// Best combo: TUE+THU+FRI+SAT+SUN · W-Sharpe 3.81 · S2-Sharpe 3.07
//
// Entry:   Price closes above upper Keltner Channel (bullish breakout)
//          filtered by CCI not in oversold extreme for longs.
// SL:      ATR × atr_stop_mult below/above entry (default 2.0 ×)
// TP:      SL distance × rr_ratio (default 2.0 × = 1:2 R:R)
// Sizing:  (equity × risk %) / ATR-based stop distance

strategy('SWING5: Keltner Breakout', overlay=true, initial_capital=100000, currency='USD',
         default_qty_type=strategy.fixed, default_qty_value=1)

// === RISK ===
risk_per_trade = input.float(1.0, 'Risk % / Trade', minval=0.1, maxval=5,  group='Risk')
atr_stop_mult  = input.float(2.0, 'ATR Stop Mult',  minval=0.5, maxval=10, group='Risk')
rr_ratio       = input.float(2.0, 'R:R Ratio',      minval=0.5, maxval=10, group='Risk')

// === STRATEGY ===
direction    = input.string('Long', 'Direction', options=['Long','Short','Both'], group='Strategy')
kc_length    = input.int(15,   'KC Length',   minval=5,   group='Strategy')
kc_mult      = input.float(1.5,'KC Mult',     minval=0.5, group='Strategy')
cci_period   = input.int(14,   'CCI Period',  minval=2,   group='Strategy')
cci_long_min = input.int(-100, 'CCI Min (Long)',  group='Strategy')
cci_short_max= input.int(0,    'CCI Max (Short)', group='Strategy')

// === DAY FILTER — defaults = TUE+THU+FRI+SAT+SUN (best combo) ===
trade_mon = input.bool(false, 'Mon', group='Days', inline='d')
trade_tue = input.bool(true,  'Tue', group='Days', inline='d')
trade_wed = input.bool(false, 'Wed', group='Days', inline='d')
trade_thu = input.bool(true,  'Thu', group='Days', inline='d')
trade_fri = input.bool(true,  'Fri', group='Days', inline='d')
trade_sat = input.bool(true,  'Sat', group='Days', inline='d')
trade_sun = input.bool(true,  'Sun', group='Days', inline='d')

// === VISUALS ===
show_lines = input.bool(true, 'Show Trade Lines', group='Visual')
line_bars  = input.int(45, 'Line Bars', minval=1, maxval=200, group='Visual')

// === INDICATORS ===
ema_mid  = ta.ema(close, kc_length)
atr      = ta.atr(kc_length)
upper_kc = ema_mid + kc_mult * atr
lower_kc = ema_mid - kc_mult * atr
cci      = ta.cci(close, cci_period)
atr14    = ta.atr(14)

// === DAY FILTER ===
allow_day = (dayofweek == dayofweek.monday    and trade_mon) or
  (dayofweek == dayofweek.tuesday   and trade_tue) or
  (dayofweek == dayofweek.wednesday and trade_wed) or
  (dayofweek == dayofweek.thursday  and trade_thu) or
  (dayofweek == dayofweek.friday    and trade_fri) or
  (dayofweek == dayofweek.saturday  and trade_sat) or
  (dayofweek == dayofweek.sunday    and trade_sun)

long_ok  = direction == 'Long'  or direction == 'Both'
short_ok = direction == 'Short' or direction == 'Both'

// === POSITION SIZING ===
risk_amt  = strategy.equity * risk_per_trade / 100
stop_dist = atr14 * atr_stop_mult
qty       = stop_dist > 0 ? risk_amt / stop_dist : 0

// === ENTRIES ===
long_cond  = close > upper_kc and cci > cci_long_min  and allow_day and long_ok  and strategy.position_size == 0
short_cond = close < lower_kc and cci < cci_short_max and allow_day and short_ok and strategy.position_size == 0

if long_cond and qty > 0
    sl = close - stop_dist
    tp = close + stop_dist * rr_ratio
    strategy.entry('Long',  strategy.long,  qty=qty)
    strategy.exit ('Exit L','Long',  stop=sl, limit=tp)

if short_cond and qty > 0
    sl = close + stop_dist
    tp = close - stop_dist * rr_ratio
    strategy.entry('Short', strategy.short, qty=qty)
    strategy.exit ('Exit S','Short', stop=sl, limit=tp)

// === TRADE LINES ===
if show_lines and strategy.position_size > 0 and strategy.position_size[1] <= 0
    e  = strategy.position_avg_price
    sd = atr14 * atr_stop_mult
    line.new(bar_index, e,          bar_index+line_bars, e,          color=color.white, width=2)
    line.new(bar_index, e-sd,       bar_index+line_bars, e-sd,       color=color.red,   width=2)
    line.new(bar_index, e+sd*rr_ratio, bar_index+line_bars, e+sd*rr_ratio, color=color.green, width=2)

if show_lines and strategy.position_size < 0 and strategy.position_size[1] >= 0
    e  = strategy.position_avg_price
    sd = atr14 * atr_stop_mult
    line.new(bar_index, e,          bar_index+line_bars, e,          color=color.white, width=2)
    line.new(bar_index, e+sd,       bar_index+line_bars, e+sd,       color=color.red,   width=2)
    line.new(bar_index, e-sd*rr_ratio, bar_index+line_bars, e-sd*rr_ratio, color=color.green, width=2)

plot(upper_kc, 'Upper KC', color.red,   linewidth=1)
plot(lower_kc, 'Lower KC', color.green, linewidth=1)
plot(ema_mid,  'EMA Mid',  color.blue,  linewidth=1)
