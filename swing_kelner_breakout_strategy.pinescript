pinescript
//@version=5
// SWING STRATEGIES (1H-4H, Fewer Trades, Bigger Moves)
// SWING #5: Keltner Breakout (Trend Continuation)
// TF: 1H | Type: Long/Short | Target: 1:3 R/R

strategy("SWING5: Keltner Breakout - Risk Based", overlay=true, initial_capital=100000, currency="USD")

// === INPUTS ===
risk_per_trade = input.float(1.0, "Risk % per Trade", minval=0.1, maxval=5)
kc_length = input.int(20, "KC Length")
kc_mult = input.float(2.0, "KC Multiplier")
cci_period = input.int(20, "CCI Period")

trade_mon = input.bool(true, "Monday")
trade_tue = input.bool(true, "Tuesday")
trade_wed = input.bool(true, "Wednesday")
trade_thu = input.bool(true, "Thursday")
trade_fri = input.bool(true, "Friday")
trade_sat = input.bool(true, "Saturday")
trade_sun = input.bool(true, "Sunday")

// === INDICATORS ===
ema = ta.ema(close, kc_length)
atr = ta.atr(kc_length)
upper_kc = ema + kc_mult * atr
lower_kc = ema - kc_mult * atr
cci = ta.cci(close, cci_period)

// === FILTERS ===
dow = dayofweek
allow_day = (dow == 1 and trade_mon) or (dow == 2 and trade_tue) or (dow == 3 and trade_wed) or (dow == 4 and trade_thu) or (dow == 5 and trade_fri) or (dow == 6 and trade_sat) or (dow == 7 and trade_sun)

// === POSITION SIZING ===
risk_amount = strategy.equity * risk_per_trade / 100
stop_dist = atr * 2
qty = risk_amount / stop_dist

// === ENTRIES ===
long_cond = close > upper_kc and cci > -100 and allow_day
short_cond = close < lower_kc and cci < 100 and allow_day

// === EXECUTION ===
if long_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=qty)
    strategy.exit("Exit", "Long", loss=ema, profit=close + (stop_dist * 3))

if short_cond and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("Exit", "Short", loss=ema, profit=close - (stop_dist * 3))

plot(upper_kc, "Upper KC", color.red)
plot(lower_kc, "Lower KC", color.green)
plot(ema, "EMA", color.blue)

---

SWING #6: Multi-Timeframe EMA Stack (Higher Bias)
TF: 30m entry / 4H bias | Type: Long/Short | Target: 1:2.5 R/R

pinescript
//@version=5
strategy("SWING6: MTF EMA Stack - Risk Based", overlay=true, initial_capital=100000, currency="USD")

// === INPUTS ===
risk_per_trade = input.float(1.0, "Risk % per Trade", minval=0.1, maxval=5)
htf_ema = input.int(20, "HTF EMA (4H bias)")
ltf_fast = input.int(9, "LTF Fast EMA")
ltf_slow = input.int(21, "LTF Slow EMA")

trade_mon = input.bool(true, "Monday")
trade_tue = input.bool(true, "Tuesday")
trade_wed = input.bool(true, "Wednesday")
trade_thu = input.bool(true, "Thursday")
trade_fri = input.bool(true, "Friday")
trade_sat = input.bool(true, "Saturday")
trade_sun = input.bool(true, "Sunday")

// === MTF INDICATORS ===
htf_close = request.security(syminfo.tickerid, "240", close)
htf_ema_val = request.security(syminfo.tickerid, "240", ta.ema(close, htf_ema))

ltf_fast_ema = ta.ema(close, ltf_fast)
ltf_slow_ema = ta.ema(close, ltf_slow)
atr = ta.atr(14)

// === FILTERS ===
dow = dayofweek
allow_day = (dow == 1 and trade_mon) or (dow == 2 and trade_tue) or (dow == 3 and trade_wed) or (dow == 4 and trade_thu) or (dow == 5 and trade_fri) or (dow == 6 and trade_sat) or (dow == 7 and trade_sun)

bull_bias = htf_close > htf_ema_val
bear_bias = htf_close < htf_ema_val

// === POSITION SIZING ===
risk_amount = strategy.equity * risk_per_trade / 100
stop_dist = atr * 2
qty = risk_amount / stop_dist

// === ENTRIES ===
bull_cross = ta.crossover(ltf_fast_ema, ltf_slow_ema)
bear_cross = ta.crossunder(ltf_fast_ema, ltf_slow_ema)

long_cond = bull_bias and bull_cross and allow_day
short_cond = bear_bias and bear_cross and allow_day

// === EXECUTION ===
if long_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=qty)
    strategy.exit("Exit", "Long", loss=close - stop_dist, profit=close + (stop_dist * 2.5))

if short_cond and strategy.position_size == 0
    strategy.entry("Short", strategy.sh
[08.04.2026 04:30] TVRemix: ort, qty=qty)
    strategy.exit("Exit", "Short", loss=close + stop_dist, profit=close - (stop_dist * 2.5))

plot(ltf_fast_ema, "Fast", color.blue)
plot(ltf_slow_ema, "Slow", color.red)
bgcolor(bull_bias ? color.new(color.green, 90) : bear_bias ? color.new(color.red, 90) : na)
