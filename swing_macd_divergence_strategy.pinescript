//@version=6
// SWING4: MACD Divergence (Momentum Reversal)
// Optimised: ENAUSDT · 1H · Long only · Fixed-% SL/TP
// Best combo: MON+THU+FRI+SUN · W-Sharpe 6.32 · S2-Sharpe 4.83
// ⚠️  ENAUSDT has ~9 months of history (Apr–Dec 2024) — paper trade before live
//
// Entry:   Bullish MACD histogram divergence (price new low, histogram higher low)
//          confirmed by RSI ≤ rsi_long_max; inverse for shorts.
// SL:      Fixed % below entry (default 2.5 %)
// TP:      Fixed % above entry (default 8.0 %)
// Sizing:  (equity × risk %) / stop_distance in price

strategy('SWING4: MACD Divergence', overlay=true, initial_capital=100000, currency='USD',
         default_qty_type=strategy.fixed, default_qty_value=1)

// === RISK ===
risk_per_trade  = input.float(1.0, 'Risk % / Trade', minval=0.1, maxval=5,  group='Risk')
stop_loss_pct   = input.float(2.5, 'Stop Loss %',    minval=0.1, maxval=20, group='Risk')
take_profit_pct = input.float(8.0, 'Take Profit %',  minval=0.1, maxval=50, group='Risk')

// === STRATEGY ===
direction    = input.string('Long', 'Direction', options=['Long','Short','Both'], group='Strategy')
macd_fast    = input.int(10, 'MACD Fast',           minval=1, group='Strategy')
macd_slow    = input.int(24, 'MACD Slow',           minval=1, group='Strategy')
macd_sig     = input.int(7,  'MACD Signal',         minval=1, group='Strategy')
rsi_period   = input.int(10, 'RSI Period',          minval=1, group='Strategy')
div_lookback = input.int(3,  'Divergence Lookback', minval=2, maxval=20, group='Strategy')
rsi_long_max = input.int(50, 'RSI Max (Long)',      group='Strategy')
rsi_short_min= input.int(50, 'RSI Min (Short)',     group='Strategy')

// === DAY FILTER — defaults = MON+THU+FRI+SUN (best combo) ===
trade_mon = input.bool(true,  'Mon', group='Days', inline='d')
trade_tue = input.bool(false, 'Tue', group='Days', inline='d')
trade_wed = input.bool(false, 'Wed', group='Days', inline='d')
trade_thu = input.bool(true,  'Thu', group='Days', inline='d')
trade_fri = input.bool(true,  'Fri', group='Days', inline='d')
trade_sat = input.bool(false, 'Sat', group='Days', inline='d')
trade_sun = input.bool(true,  'Sun', group='Days', inline='d')

// === VISUALS ===
show_lines = input.bool(true, 'Show Trade Lines', group='Visual')
line_bars  = input.int(45, 'Line Bars', minval=1, maxval=200, group='Visual')

// === INDICATORS ===
[_, _, hist] = ta.macd(close, macd_fast, macd_slow, macd_sig)
rsi          = ta.rsi(close, rsi_period)

// === DIVERGENCE DETECTION ===
// Bullish: price makes new low but histogram does NOT confirm (higher low = momentum diverges)
bull_div = low  < ta.lowest(low,  div_lookback)[1] and hist > ta.lowest(hist, div_lookback)[1]
// Bearish: price makes new high but histogram does NOT confirm (lower high)
bear_div = high > ta.highest(high, div_lookback)[1] and hist < ta.highest(hist, div_lookback)[1]

// === DAY FILTER ===
allow_day = (dayofweek == dayofweek.monday    and trade_mon) or
  (dayofweek == dayofweek.tuesday   and trade_tue) or
  (dayofweek == dayofweek.wednesday and trade_wed) or
  (dayofweek == dayofweek.thursday  and trade_thu) or
  (dayofweek == dayofweek.friday    and trade_fri) or
  (dayofweek == dayofweek.saturday  and trade_sat) or
  (dayofweek == dayofweek.sunday    and trade_sun)

long_ok  = (direction == 'Long'  or direction == 'Both')
short_ok = (direction == 'Short' or direction == 'Both')

// === POSITION SIZING ===
risk_amt   = strategy.equity * risk_per_trade / 100
stop_dist  = close * stop_loss_pct / 100
qty        = stop_dist > 0 ? risk_amt / stop_dist : 0

// === ENTRIES ===
long_cond  = bull_div and rsi <= rsi_long_max  and allow_day and long_ok  and strategy.position_size == 0
short_cond = bear_div and rsi >= rsi_short_min and allow_day and short_ok and strategy.position_size == 0

if long_cond and qty > 0
    sl = close * (1 - stop_loss_pct   / 100)
    tp = close * (1 + take_profit_pct / 100)
    strategy.entry('Long',  strategy.long,  qty=qty)
    strategy.exit ('Exit L','Long',  stop=sl, limit=tp)

if short_cond and qty > 0
    sl = close * (1 + stop_loss_pct   / 100)
    tp = close * (1 - take_profit_pct / 100)
    strategy.entry('Short', strategy.short, qty=qty)
    strategy.exit ('Exit S','Short', stop=sl, limit=tp)

// === TRADE LINES ===
if show_lines and strategy.position_size > 0 and strategy.position_size[1] <= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                                    bar_index+line_bars, e,                                    color=color.white, width=2)
    line.new(bar_index, e*(1-stop_loss_pct/100),              bar_index+line_bars, e*(1-stop_loss_pct/100),              color=color.red,   width=2)
    line.new(bar_index, e*(1+take_profit_pct/100),            bar_index+line_bars, e*(1+take_profit_pct/100),            color=color.green, width=2)

if show_lines and strategy.position_size < 0 and strategy.position_size[1] >= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                                    bar_index+line_bars, e,                                    color=color.white, width=2)
    line.new(bar_index, e*(1+stop_loss_pct/100),              bar_index+line_bars, e*(1+stop_loss_pct/100),              color=color.red,   width=2)
    line.new(bar_index, e*(1-take_profit_pct/100),            bar_index+line_bars, e*(1-take_profit_pct/100),            color=color.green, width=2)

plotshape(long_cond,  title='Long',  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)
plotshape(short_cond, title='Short', style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small)
