//@version=6
// AGGR_PULLBACK: Engulfing Candle Pullback (EMA Trend + Engulfing Reversal)
// Optimised: TRXUSDT · 1H · Long only · Fixed-% SL/TP
// Best combo: TUE+WED+THU+FRI+SAT+SUN · W-Sharpe 2.96 · S2-Sharpe 2.68
//
// Entry:   Bullish (or bearish) engulfing candle that forms when price pulls back
//          near EMA20, while EMA200 confirms the broader trend direction.
//          Swing low/high of last swing_lookback bars must be at or near signal candle.
//          Massive candle filter avoids chasing over-extended moves.
// SL:      Fixed % from entry (default 2.0 %)
// TP:      Fixed % from entry (default 8.0 %)
// Sizing:  (equity × risk %) / stop_distance in price

strategy('AGGR_PULLBACK: Engulfing Pullback', overlay=true, initial_capital=100000, currency='USD',
         default_qty_type=strategy.fixed, default_qty_value=1)

// === RISK ===
risk_per_trade  = input.float(1.0, 'Risk % / Trade', minval=0.1, maxval=5,  group='Risk')
stop_loss_pct   = input.float(2.0, 'Stop Loss %',    minval=0.1, maxval=20, group='Risk')
take_profit_pct = input.float(8.0, 'Take Profit %',  minval=0.1, maxval=50, group='Risk')

// === STRATEGY ===
direction         = input.string('Long', 'Direction', options=['Long','Short','Both'], group='Strategy')
ema_length        = input.int(20,  'EMA Fast',           minval=5,   group='Strategy')
ema200_length     = input.int(200, 'EMA Trend',          minval=50,  group='Strategy')
swing_lookback    = input.int(5,   'Swing Lookback',     minval=2,   group='Strategy')
massive_mult      = input.float(2.0,'Massive Candle ATR Mult', minval=1.0, group='Strategy')
pullback_bars     = input.int(3,   'Pullback Check Bars',minval=1,   group='Strategy')

// === DAY FILTER — defaults = TUE+WED+THU+FRI+SAT+SUN (best combo) ===
trade_mon = input.bool(false, 'Mon', group='Days', inline='d')
trade_tue = input.bool(true,  'Tue', group='Days', inline='d')
trade_wed = input.bool(true,  'Wed', group='Days', inline='d')
trade_thu = input.bool(true,  'Thu', group='Days', inline='d')
trade_fri = input.bool(true,  'Fri', group='Days', inline='d')
trade_sat = input.bool(true,  'Sat', group='Days', inline='d')
trade_sun = input.bool(true,  'Sun', group='Days', inline='d')

// === VISUALS ===
show_lines = input.bool(true, 'Show Trade Lines', group='Visual')
show_ema   = input.bool(true, 'Show EMAs',        group='Visual')
line_bars  = input.int(45, 'Line Bars', minval=1, maxval=200, group='Visual')

// === INDICATORS ===
ema_fast = ta.ema(close, ema_length)
ema_slow = ta.ema(close, ema200_length)
atr      = ta.atr(14)

// === ENGULFING PATTERNS ===
bull_engulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bear_engulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

// === PULLBACK FILTER — price must be near EMA ===
below_ema_count = 0
above_ema_count = 0
for i = 1 to pullback_bars
    below_ema_count := below_ema_count + (close[i] < ema_fast[i] ? 1 : 0)
    above_ema_count := above_ema_count + (close[i] > ema_fast[i] ? 1 : 0)
long_pullback_ok  = below_ema_count <= 1  // price not too far below EMA
short_pullback_ok = above_ema_count <= 1

// === SWING STRUCTURE ===
swing_low  = ta.lowest(low,  swing_lookback)
swing_high = ta.highest(high, swing_lookback)
at_swing_low  = low  == swing_low  or low[1]  == swing_low[1]
at_swing_high = high == swing_high or high[1] == swing_high[1]

// === MASSIVE CANDLE FILTER ===
not_massive = ta.tr < atr * massive_mult

// === DAY FILTER ===
allow_day = (dayofweek == dayofweek.monday    and trade_mon) or
            (dayofweek == dayofweek.tuesday   and trade_tue) or
            (dayofweek == dayofweek.wednesday and trade_wed) or
            (dayofweek == dayofweek.thursday  and trade_thu) or
            (dayofweek == dayofweek.friday    and trade_fri) or
            (dayofweek == dayofweek.saturday  and trade_sat) or
            (dayofweek == dayofweek.sunday    and trade_sun)

long_ok  = direction == 'Long'  or direction == 'Both'
short_ok = direction == 'Short' or direction == 'Both'

// === ENTRIES ===
long_cond  = bull_engulf and close > ema_fast and close > ema_slow and long_pullback_ok  and at_swing_low  and not_massive and allow_day and long_ok  and strategy.position_size == 0
short_cond = bear_engulf and close < ema_fast and close < ema_slow and short_pullback_ok and at_swing_high and not_massive and allow_day and short_ok and strategy.position_size == 0

// === POSITION SIZING ===
risk_amt  = strategy.equity * risk_per_trade / 100
stop_dist = close * stop_loss_pct / 100
qty       = stop_dist > 0 ? risk_amt / stop_dist : 0

if long_cond and qty > 0
    sl = close * (1 - stop_loss_pct   / 100)
    tp = close * (1 + take_profit_pct / 100)
    strategy.entry('Long',  strategy.long,  qty=qty)
    strategy.exit ('Exit L','Long',  stop=sl, limit=tp)

if short_cond and qty > 0
    sl = close * (1 + stop_loss_pct   / 100)
    tp = close * (1 - take_profit_pct / 100)
    strategy.entry('Short', strategy.short, qty=qty)
    strategy.exit ('Exit S','Short', stop=sl, limit=tp)

// === TRADE LINES ===
if show_lines and strategy.position_size > 0 and strategy.position_size[1] <= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                         bar_index+line_bars, e,                         color=color.white, width=2)
    line.new(bar_index, e*(1-stop_loss_pct/100),   bar_index+line_bars, e*(1-stop_loss_pct/100),   color=color.red,   width=2)
    line.new(bar_index, e*(1+take_profit_pct/100), bar_index+line_bars, e*(1+take_profit_pct/100), color=color.green, width=2)

if show_lines and strategy.position_size < 0 and strategy.position_size[1] >= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                         bar_index+line_bars, e,                         color=color.white, width=2)
    line.new(bar_index, e*(1+stop_loss_pct/100),   bar_index+line_bars, e*(1+stop_loss_pct/100),   color=color.red,   width=2)
    line.new(bar_index, e*(1-take_profit_pct/100), bar_index+line_bars, e*(1-take_profit_pct/100), color=color.green, width=2)

// === PLOTS ===
plot(show_ema ? ema_fast : na, 'EMA Fast', color.blue,   linewidth=2)
plot(show_ema ? ema_slow : na, 'EMA Slow', color.orange, linewidth=2)
plotshape(long_cond,  'Long',  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(short_cond, 'Short', shape.triangledown, location.abovebar, color.red,   size=size.small)
