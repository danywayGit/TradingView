//@version=6
strategy(title = 'Aggressive Pullback Strategy', shorttitle = 'AggrPB_Strat', overlay = true,
  default_qty_type = strategy.cash, default_qty_value = 0,
  initial_capital = 10000, commission_value = 0.1)

// === Input Parameters ===
emaLength = input.int(title = 'EMA Length', defval = 20, minval = 1, group = 'Trend')
ema200Length = input.int(title = 'EMA 200 Length', defval = 200, minval = 1, group = 'Trend')
showEma = input.bool(title = 'Show EMA', defval = true, group = 'Trend')

atrPeriod = input.int(title = 'ATR Period', defval = 14, minval = 1, group = 'Risk Management')
stopMultiplier = input.float(title = 'Stop Size Multiplier (ATR)', defval = 3, minval = 0.1, step = 0.1, group = 'Risk Management')
rrRatio = input.float(title = 'Risk/Reward Ratio', defval = 2, minval = 0.1, step = 0.1, group = 'Risk Management')
riskPerTrade = input.float(title = 'Risk Per Trade (%)', defval = 1.0, minval = 0.1, maxval = 100, step = 0.1, group = 'Risk Management')

tradeDirection = input.string(title = 'Trade Direction', options = ['Long', 'Short', 'Both'], defval = 'Both', group = 'Filters')
tradeMon = input.bool(title = 'Mon', defval = true, group = 'Filters', inline = 'days1')
tradeTue = input.bool(title = 'Tue', defval = true, group = 'Filters', inline = 'days1')
tradeWed = input.bool(title = 'Wed', defval = true, group = 'Filters', inline = 'days1')
tradeThu = input.bool(title = 'Thu', defval = true, group = 'Filters', inline = 'days1')
tradeFri = input.bool(title = 'Fri', defval = true, group = 'Filters', inline = 'days2')
tradeSat = input.bool(title = 'Sat', defval = true, group = 'Filters', inline = 'days2')
tradeSun = input.bool(title = 'Sun', defval = true, group = 'Filters', inline = 'days2')
hourStart = input.int(title = 'Hour Start', defval = 0, minval = 0, maxval = 23, group = 'Filters', inline = 'hours')
hourEnd = input.int(title = 'Hour End', defval = 23, minval = 0, maxval = 23, group = 'Filters', inline = 'hours')

// === Filter Logic ===
currentDay = dayofweek
dayAllowed = (currentDay == dayofweek.monday and tradeMon) or
  (currentDay == dayofweek.tuesday and tradeTue) or
  (currentDay == dayofweek.wednesday and tradeWed) or
  (currentDay == dayofweek.thursday and tradeThu) or
  (currentDay == dayofweek.friday and tradeFri) or
  (currentDay == dayofweek.saturday and tradeSat) or
  (currentDay == dayofweek.sunday and tradeSun)

currentHour = hour
hourAllowed = hourStart <= hourEnd ?
  (currentHour >= hourStart and currentHour <= hourEnd) :
  (currentHour >= hourStart or currentHour <= hourEnd)

longAllowed = (tradeDirection == 'Long' or tradeDirection == 'Both') and dayAllowed and hourAllowed
shortAllowed = (tradeDirection == 'Short' or tradeDirection == 'Both') and dayAllowed and hourAllowed

// === Core Calculations ===
ema = ta.ema(close, emaLength)
ema200 = ta.ema(close, ema200Length)
atr = ta.atr(atrPeriod)

// === Engulfing Pattern Detection ===
bullishEngulfing = close > open and close[1] < open[1] and close > open[1] and open <= close[1]
bearishEngulfing = close < open and close[1] > open[1] and close < open[1] and open >= close[1]

// === Pullback Consistency Filter ===
// Long: no more than 1 bar closed below EMA in past 3 bars
barsClosedBelowEMA = (close[1] < ema[1] ? 1 : 0) + (close[2] < ema[2] ? 1 : 0) + (close[3] < ema[3] ? 1 : 0)
longPullbackOk = barsClosedBelowEMA <= 1

// Short: no more than 1 bar closed above EMA in past 3 bars
barsClosedAboveEMA = (close[1] > ema[1] ? 1 : 0) + (close[2] > ema[2] ? 1 : 0) + (close[3] > ema[3] ? 1 : 0)
shortPullbackOk = barsClosedAboveEMA <= 1

// === Swing Low/High Requirement ===
// Signal candle or previous candle must be the lowest low / highest high of past 7 bars
swingLow7 = ta.lowest(low, 7)
swingHigh7 = ta.highest(high, 7)
isSwingLow = low == swingLow7 or low[1] == swingLow7[1]
isSwingHigh = high == swingHigh7 or high[1] == swingHigh7[1]

// === Massive Candle Filter ===
highestOpen5 = ta.highest(open, 5)
lowestOpen5 = ta.lowest(open, 5)
truRange = ta.tr

longNotMassive = close < highestOpen5 and truRange < atr * 2
shortNotMassive = close > lowestOpen5 and truRange < atr * 2

// === Combined Entry Conditions ===
longCondition = longAllowed and close > ema and close > ema200 and longPullbackOk and bullishEngulfing and isSwingLow and longNotMassive
shortCondition = shortAllowed and close < ema and close < ema200 and shortPullbackOk and bearishEngulfing and isSwingHigh and shortNotMassive

// === Trade Management ===
longStopDistance = (close - ta.lowest(low, 7)) + (atr * stopMultiplier)
longStopPrice = close - longStopDistance
longTpPrice = close + (longStopDistance * rrRatio)

shortStopDistance = (ta.highest(high, 7) - close) + (atr * stopMultiplier)
shortStopPrice = close + shortStopDistance
shortTpPrice = close - (shortStopDistance * rrRatio)

// === Position Sizing ===
// Qty = (Equity * Risk%) / Stop Distance per unit
riskAmount = strategy.equity * (riskPerTrade / 100)
longQty = longStopDistance > 0 ? riskAmount / longStopDistance : 0
shortQty = shortStopDistance > 0 ? riskAmount / shortStopDistance : 0

// === Strategy Execution ===
if longCondition and longQty > 0
    strategy.entry("Long", strategy.long, qty = longQty)
    strategy.exit("Long Exit", "Long", stop = longStopPrice, limit = longTpPrice)

if shortCondition and shortQty > 0
    strategy.entry("Short", strategy.short, qty = shortQty)
    strategy.exit("Short Exit", "Short", stop = shortStopPrice, limit = shortTpPrice)

// === Plotting ===
plot(title = 'EMA', series = showEma ? ema : na, color = color.new(color.blue, 0), linewidth = 2)
plot(title = 'EMA 200', series = showEma ? ema200 : na, color = color.new(color.orange, 0), linewidth = 2)

plotshape(series = longCondition, title = 'Long Signal', style = shape.triangleup,
  location = location.belowbar, color = color.green, size = size.normal)

plotshape(series = shortCondition, title = 'Short Signal', style = shape.triangledown,
  location = location.abovebar, color = color.red, size = size.normal)

// === Debug Plots ===
//plot(title = 'ATR', series = atr, color = color.new(color.orange, 100), linewidth = 2)
//plot(title = 'Bars Below EMA', series = barsClosedBelowEMA, color = color.new(color.red, 100), linewidth = 2)
//plot(title = 'Bars Above EMA', series = barsClosedAboveEMA, color = color.new(color.red, 100), linewidth = 2)
//plot(title = 'Bullish Engulfing', series = bullishEngulfing ? 1 : 0, color = color.new(color.green, 100), linewidth = 2)
//plot(title = 'Bearish Engulfing', series = bearishEngulfing ? 1 : 0, color = color.new(color.red, 100), linewidth = 2)
