//@version=6
// SWING STRATEGIES (1H-4H, Fewer Trades, Bigger Moves)
// SWING #1: EMA Wave + Volume (Trend Following)
// TF: 1H | Type: Long/Short | Target: 1:3 R/R
//
// Description:
//   EMA wave trend-following strategy with volume confirmation. Enters when the fast EMA
//   is above/below the slow EMA, RSI crosses the momentum threshold, price is aligned
//   with the fast EMA, and volume exceeds its moving average.
//
// Main idea:     Ride trending moves confirmed by EMA alignment and above-average volume.
// Max hold bars: NA — exits managed by ATR-based SL (2×) and 1:3 R:R TP.
// Stop loss:     ATR × 2 below/above entry.
// Take profit:   SL distance × 3 (1:3 R:R).

strategy('SWING1: EMA Wave + Volume - Risk Based', overlay = true, initial_capital = 100000, currency = 'USD')

// === INPUTS ===
risk_per_trade = input.float(1.0, 'Risk % per Trade', minval = 0.1, maxval = 5)
ema_fast = input.int(9, 'Fast EMA')
ema_slow = input.int(21, 'Slow EMA')
rsi_period = input.int(14, 'RSI Period')
rsi_long = input.int(40, 'RSI Long')
rsi_short = input.int(60, 'RSI Short')
volume_ma = input.int(20, 'Volume MA')

trade_mon = input.bool(true, 'Monday')
trade_tue = input.bool(true, 'Tuesday')
trade_wed = input.bool(true, 'Wednesday')
trade_thu = input.bool(true, 'Thursday')
trade_fri = input.bool(true, 'Friday')
trade_sat = input.bool(true, 'Saturday')
trade_sun = input.bool(true, 'Sunday')
show_trade_lines = input.bool(true, 'Show Trade Lines')
trade_line_bars = input.int(45, 'Trade Line Bars', minval = 1, maxval = 100)

// === INDICATORS ===
ema_f = ta.ema(close, ema_fast)
ema_s = ta.ema(close, ema_slow)
rsi = ta.rsi(close, rsi_period)
atr = ta.atr(14)
vol_ma = ta.sma(volume, volume_ma)

// === FILTERS ===
dow = dayofweek
allow_day = dow == 1 and trade_mon or dow == 2 and trade_tue or dow == 3 and trade_wed or dow == 4 and trade_thu or dow == 5 and trade_fri or dow == 6 and trade_sat or dow == 7 and trade_sun
high_vol = volume > vol_ma

// === POSITION SIZING ===
risk_amount = strategy.equity * risk_per_trade / 100
stop_dist = atr * 2
qty = risk_amount / stop_dist

// === ENTRIES ===
long_cond = ema_f > ema_s and ta.crossover(rsi, rsi_long) and close > ema_f and high_vol and allow_day
short_cond = ema_f < ema_s and ta.crossunder(rsi, rsi_short) and close < ema_f and high_vol and allow_day

// === EXECUTION ===
if long_cond and strategy.position_size == 0
    strategy.entry('Long', strategy.long, qty = qty)
    strategy.exit('Exit Long', 'Long', stop = close - stop_dist, limit = close + stop_dist * 3)

if short_cond and strategy.position_size == 0
    strategy.entry('Short', strategy.short, qty = qty)
    strategy.exit('Exit Short', 'Short', stop = close + stop_dist, limit = close - stop_dist * 3)

// === Trade Lines ===
if show_trade_lines and strategy.position_size > 0 and strategy.position_size[1] <= 0
    _entry = strategy.position_avg_price
    _sl = _entry - stop_dist
    _tp = _entry + stop_dist * 3
    line.new(bar_index, _entry, bar_index + trade_line_bars, _entry, color = color.white, width = 2)
    line.new(bar_index, _sl, bar_index + trade_line_bars, _sl, color = color.red, width = 2)
    line.new(bar_index, _tp, bar_index + trade_line_bars, _tp, color = color.green, width = 2)

if show_trade_lines and strategy.position_size < 0 and strategy.position_size[1] >= 0
    _entry = strategy.position_avg_price
    _sl = _entry + stop_dist
    _tp = _entry - stop_dist * 3
    line.new(bar_index, _entry, bar_index + trade_line_bars, _entry, color = color.white, width = 2)
    line.new(bar_index, _sl, bar_index + trade_line_bars, _sl, color = color.red, width = 2)
    line.new(bar_index, _tp, bar_index + trade_line_bars, _tp, color = color.green, width = 2)

plot(ema_f, 'Fast', color.blue)
plot(ema_s, 'Slow', color.red)
