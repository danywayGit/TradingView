//@version=6
// SWING3: Supertrend + ADX Power (Strong Trend)
// Optimised: DOTUSDT · 15m · Long & Short · Fixed-% SL/TP
// Best combo: MON+THU+SUN · W-Sharpe 3.94 · S2-Sharpe 2.11
//
// Entry:   Supertrend flips bullish/bearish + ADX > threshold (strong trend)
//          + price on correct side of EMA filter.
// SL:      Fixed % from entry (default 1.5 %) — matches backtested fixed_signal type.
//          Optional Supertrend Trailing exit available via exit_mode input.
// TP:      Fixed % from entry (default 3.0 %).
// Sizing:  (equity × risk %) / stop_distance in price

strategy('SWING3: Supertrend + ADX', overlay=true, initial_capital=100000, currency='USD',
         default_qty_type=strategy.fixed, default_qty_value=1)

// === RISK ===
risk_per_trade  = input.float(1.0, 'Risk % / Trade', minval=0.1, maxval=5,  group='Risk')
stop_loss_pct   = input.float(1.5, 'Stop Loss %',    minval=0.1, maxval=20, group='Risk')
take_profit_pct = input.float(3.0, 'Take Profit %',  minval=0.1, maxval=50, group='Risk')
exit_mode       = input.string('Fixed R:R', 'Exit Mode', options=['Fixed R:R','ST Trailing'], group='Risk')

// === STRATEGY ===
direction     = input.string('Both', 'Direction', options=['Long','Short','Both'], group='Strategy')
st_period     = input.int(14,   'ST Period',       minval=1,   group='Strategy')
st_factor     = input.float(3.0,'ST Factor',       minval=0.1, group='Strategy')
adx_period    = input.int(14,   'ADX Period',      minval=1,   group='Strategy')
adx_threshold = input.int(25,   'ADX Threshold',   minval=10,  group='Strategy')
ema_filter    = input.int(200,  'EMA Filter',      minval=10,  group='Strategy')

// === DAY FILTER — defaults = MON+THU+SUN (best combo) ===
trade_mon = input.bool(true,  'Mon', group='Days', inline='d')
trade_tue = input.bool(false, 'Tue', group='Days', inline='d')
trade_wed = input.bool(false, 'Wed', group='Days', inline='d')
trade_thu = input.bool(true,  'Thu', group='Days', inline='d')
trade_fri = input.bool(false, 'Fri', group='Days', inline='d')
trade_sat = input.bool(false, 'Sat', group='Days', inline='d')
trade_sun = input.bool(true,  'Sun', group='Days', inline='d')

// === VISUALS ===
show_lines = input.bool(true, 'Show Trade Lines', group='Visual')
line_bars  = input.int(45, 'Line Bars', minval=1, maxval=200, group='Visual')

// === INDICATORS ===
[st_dir, st_level] = ta.supertrend(st_factor, st_period)
[_, _, adx]        = ta.dmi(adx_period, adx_period)
ema_filt           = ta.ema(close, ema_filter)

// === DAY FILTER ===
allow_day = (dayofweek == dayofweek.monday    and trade_mon) or
            (dayofweek == dayofweek.tuesday   and trade_tue) or
            (dayofweek == dayofweek.wednesday and trade_wed) or
            (dayofweek == dayofweek.thursday  and trade_thu) or
            (dayofweek == dayofweek.friday    and trade_fri) or
            (dayofweek == dayofweek.saturday  and trade_sat) or
            (dayofweek == dayofweek.sunday    and trade_sun)

long_ok  = direction == 'Long'  or direction == 'Both'
short_ok = direction == 'Short' or direction == 'Both'

// === SIGNALS ===
st_bull = st_dir < 0
st_bear = st_dir > 0

long_cond  = st_bull and not st_bull[1] and adx > adx_threshold and close > ema_filt and allow_day and long_ok  and strategy.position_size == 0
short_cond = st_bear and not st_bear[1] and adx > adx_threshold and close < ema_filt and allow_day and short_ok and strategy.position_size == 0

// === POSITION SIZING ===
risk_amt  = strategy.equity * risk_per_trade / 100
stop_dist = close * stop_loss_pct / 100
qty       = stop_dist > 0 ? risk_amt / stop_dist : 0

// === ENTRIES & EXITS ===
if long_cond and qty > 0
    strategy.entry('Long', strategy.long, qty=qty)
    if exit_mode == 'Fixed R:R'
        strategy.exit('Exit L', 'Long', stop=close*(1-stop_loss_pct/100), limit=close*(1+take_profit_pct/100))

if short_cond and qty > 0
    strategy.entry('Short', strategy.short, qty=qty)
    if exit_mode == 'Fixed R:R'
        strategy.exit('Exit S', 'Short', stop=close*(1+stop_loss_pct/100), limit=close*(1-take_profit_pct/100))

// Supertrend trailing exit (optional)
if exit_mode == 'ST Trailing'
    if st_bear and strategy.position_size > 0
        strategy.close('Long')
    if st_bull and strategy.position_size < 0
        strategy.close('Short')

// === TRADE LINES ===
if show_lines and strategy.position_size > 0 and strategy.position_size[1] <= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                         bar_index+line_bars, e,                         color=color.white, width=2)
    line.new(bar_index, e*(1-stop_loss_pct/100),   bar_index+line_bars, e*(1-stop_loss_pct/100),   color=color.red,   width=2)
    _tp = exit_mode == 'Fixed R:R' ? e*(1+take_profit_pct/100) : e*(1+take_profit_pct/100)
    line.new(bar_index, _tp, bar_index+line_bars, _tp, color=exit_mode=='Fixed R:R' ? color.green : color.gray, width=exit_mode=='Fixed R:R' ? 2 : 1, style=exit_mode=='ST Trailing' ? line.style_dashed : line.style_solid)

if show_lines and strategy.position_size < 0 and strategy.position_size[1] >= 0
    e = strategy.position_avg_price
    line.new(bar_index, e,                         bar_index+line_bars, e,                         color=color.white, width=2)
    line.new(bar_index, e*(1+stop_loss_pct/100),   bar_index+line_bars, e*(1+stop_loss_pct/100),   color=color.red,   width=2)
    line.new(bar_index, e*(1-take_profit_pct/100), bar_index+line_bars, e*(1-take_profit_pct/100), color=color.green, width=2)

plot(st_level, 'Supertrend', color=st_bull ? color.green : color.red, linewidth=2)
plot(ema_filt, 'EMA Filter', color.blue, linewidth=1)
